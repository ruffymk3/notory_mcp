{
  "name": "@notory/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for Notory - lets an AI assistant work with your Notory IT-inventory instance through its REST API.",
  "type": "module",
  "bin": {
    "notory-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "notory",
    "itam",
    "inventory"
  ],
  "author": "TougeTech - Raphael Ernst",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
