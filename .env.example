# Base URL of your Notory instance (no trailing /api).
NOTORY_BASE_URL=https://demo.notory.io

# A Notory API token. Create one in the web UI under Settings -> API tokens.
# Give it the "read" scope to keep the assistant read-only; "write" enables
# create/update/delete. The token inherits your role and tenant.
NOTORY_API_TOKEN=inv_your_token_here
